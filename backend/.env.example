DJANGO_SECRET_KEY=replace-this-for-non-local-environments
DJANGO_DEBUG=true
# Use explicit staging/production hostnames outside local development.
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Australia/Melbourne

DATABASE_ENGINE=mysql
MYSQL_DATABASE=vitail
MYSQL_USER=vitail
MYSQL_PASSWORD=vitail-local
MYSQL_ROOT_PASSWORD=vitail-root-local
MYSQL_HOST=db
MYSQL_PORT=3306

# Optional host ports for an isolated second Compose project.
API_PORT=8000
MYSQL_PORT_EXTERNAL=3306

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
