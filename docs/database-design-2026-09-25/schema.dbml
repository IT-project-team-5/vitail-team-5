  event_date date
  valid_from date
  valid_to date
  file varchar(200) [not null, note: 'storage key, not file content']
  filename varchar(150) [not null]
  file_content_type varchar(40) [not null]
  file_sha256 varchar(64) [not null]
  file_size_bytes bigint [note: 'nonnegative integer']
  audit_status varchar(16) [not null, note: 'choices: NOT_REVIEWED / VERIFIED / REJECTED; ORM default: \'NOT_REVIEWED\'']
  reviewed_by_id bigint [ref: > User.id, note: 'Django on_delete=PROTECT']
  reviewed_at datetime
  review_reason varchar(500) [not null]
  awarded_points int [not null, note: 'nonnegative integer; ORM default: 0']
  response_snapshot json [not null, note: 'ORM default: builtins.dict']
  submitted_at datetime [not null, note: 'ORM auto_now_add']
  indexes {
    (owner_id, request_id) [unique, name: 'evidence_owner_request_unique']
    (owner_id)
    (dog_id)
    (entitlement_id)
    (reviewed_by_id)
  }
  Note: 'Physical table: evidence_documentsubmission. Model: evidence.DocumentSubmission. All FK deletion notes are Django behavior; constraints below are exact model Q expressions.'
}

