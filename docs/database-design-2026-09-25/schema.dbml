Table DocumentSubmission {
  id bigint [pk, increment, not null]
  owner_id bigint [not null, ref: > User.id, note: 'Django on_delete=PROTECT']
  dog_id bigint [ref: > Dog.id, note: 'Django on_delete=SET_NULL']
  dog_id_snapshot bigint [not null, note: 'nonnegative integer']
  dog_name_snapshot varchar(100) [not null]
  kind varchar(30) [not null, note: 'choices: COUNCIL_REGISTRATION / MICROCHIP_REGISTRATION / VET_CHECKUP']
  status varchar(20) [not null, note: 'ORM default: \'SELF_REPORTED\'']
  request_id char(32) [not null]
  request_fingerprint varchar(64) [not null]
