// Copy this file to Local.xcconfig. The copied file is ignored by Git.
// A free Personal Team is enough for direct installation from Xcode.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = com.vitail.team5.yourname.dev

// Use your Mac's local hostname or LAN IP when testing on a physical iPhone.
// The iPhone and Mac must be on the same network.
API_BASE_URL = http:/$()/your-mac.local:8000
